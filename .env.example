# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Matches the credentials defined in docker-compose.yml
DATABASE_URL=postgresql://investhub:investhub_dev@localhost:5433/investhub

# --- Auth ---
# Only one secret needed: the refresh token is opaque random bytes with its
# hash stored in the refresh_tokens table, not a second signed JWT.
JWT_ACCESS_SECRET=change-me-access-secret

# --- Pricing provider ---
PRICING_PROVIDER=yahoo
TWELVE_DATA_API_KEY=

# --- Trading ---
# Flat fee in rupees per trade, matching a typical discount-broker model.
TRADE_FEE=20
